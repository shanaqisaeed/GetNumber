[Unit]
Description=RavyNo Voice Bridge & Audio Signaling Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ravy-no-bridge
EnvironmentFile=-/opt/ravy-no-bridge/.env
ExecStart=/opt/ravy-no-bridge/voice-bridge
Restart=always
RestartSec=3s
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ravy-no-voice-bridge

[Install]
WantedBy=multi-user.target

